{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jupiter",
  "version": "0.1.0",
  "identifier": "com.jupiter.animator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jupiter \u00b7 2D Animation Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f1f3f5"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; media-src 'self' asset: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "shortDescription": "A focused 2D PNG rigging and animation studio",
    "category": "GraphicsAndDesign",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
